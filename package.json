{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@animedes/anitrove",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"repository": {
		"url": "https://github.com/6g0kwtm3/animini-monorepo"
	},
	"scripts": {
		"build": "turbo run --log-prefix=none build --continue=dependencies-successful --affected",
		"bundlewatch": "turbo run bundlewatch --continue=dependencies-successful --affected",
		"dev": "turbo watch dev",
		"bench": "turbo run --log-prefix=none bench --affected",
		"test": "vitest --run --changed origin/master",
		"test-e2e": "turbo run --log-prefix=none test-e2e --continue=dependencies-successful --log-order=stream",
		"stryker": "stryker run --incremental",
		"knip": "knip --cache",
		"boundaries": "turbo boundaries"
	},
	"devDependencies": {
		"@ark/attest": "catalog:",
		"@prettier/plugin-oxc": "catalog:",
		"@stryker-mutator/api": "catalog:",
		"@stryker-mutator/core": "catalog:",
		"@stryker-mutator/vitest-runner": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"eslint-plugin-pnpm": "catalog:",
		"knip": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"packageManager": "pnpm@10.22.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.14.1",
			"onFail": "download"
		}
	}
}
