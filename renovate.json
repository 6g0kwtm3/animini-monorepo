{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"labels": ["dependencies"],
	"configMigration": true,
	"extends": [
		"config:recommended",
		":pinDevDependencies",
		":pinDependencies",
		":automergeStableNonMajor",
		"schedule:weekly",
		"group:allNonMajor"
	],
	"lockFileMaintenance": { "enabled": true },
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{ "matchPackageNames": ["@types/**"], "groupName": "types" },
		{ "matchPackageNames": ["/relay/"], "groupName": "relay" },
		{
			"matchDepTypes": ["action"],
			"matchUpdateTypes": ["digest"],
			"automerge": false
		},
		{ "groupName": "build", "matchPackageNames": ["/vite/"] },
		{ "groupName": "test", "matchPackageNames": ["/vitest/", "/playwright/"] },
		{
			"groupName": "lint",
			"matchPackageNames": ["/eslint/", "/oxlint/", "/prettier/"]
		}
	],
	"postUpdateOptions": ["pnpmDedupe"],
	"automergeType": "branch",
	"ignoreDeps": [
		// pinnned
		"@types/marked",
		"marked",
		// TODO: update
		"dompurify"
	]
}
