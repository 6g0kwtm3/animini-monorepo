{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@animedes/web",
	"private": true,
	"version": "0.0.0",
	"sideEffects": false,
	"type": "module",
	"main": "desktop/index.js",
	"scripts": {
		"build": "cross-env NODE_ENV=production react-router build",
		"bundlewatch": "bundlewatch",
		"check": "tsc --noEmit",
		"eslint-typegen": "node --import=tsx eslint.config.ts",
		"deploy": "wrangler pages deploy ./dist/client",
		"dev": "react-router dev",
		"electron:dev": "nodemon .",
		"electron:start": "electron .",
		"lint": "eslint --max-warnings 0 --cache . --fix",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide",
		"relay": "relay-compiler",
		"relay-watch": "relay-compiler --watch",
		"router": "react-router typegen",
		"start": "vite preview",
		"test-e2e": "NO_PROXY=localhost playwright test"
	},
	"browserslist": [
		"defaults and fully supports es6-module",
		"maintained node versions"
	],
	"dependencies": {
		"@anitrove/a": "workspace:@animedes/a@*",
		"@anitrove/design": "workspace:@animedes/design@*",
		"@anitrove/unstyled": "workspace:@animedes/unstyled@*",
		"@ariakit/react": "catalog:",
		"@hono/node-server": "catalog:",
		"@iconify-json/material-symbols": "catalog:",
		"@inlang/paraglide-js": "catalog:",
		"@material/material-color-utilities": "catalog:",
		"@react-router/dev": "catalog:",
		"@react-router/node": "catalog:",
		"@sentry/react": "catalog:",
		"@sentry/toolbar": "catalog:",
		"@sentry/vite-plugin": "catalog:",
		"@svgr/core": "catalog:",
		"@svgr/plugin-jsx": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-virtual": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"anitomy": "catalog:",
		"arktype": "catalog:",
		"cookie": "catalog:",
		"electron": "catalog:",
		"electron-devtools-installer": "catalog:",
		"extra-outlet": "workspace:@animedes/extra-outlet@*",
		"graphql": "catalog:",
		"hono": "catalog:",
		"isbot": "catalog:",
		"markdown": "workspace:@animedes/markdown@*",
		"motion": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-relay": "catalog:",
		"react-router": "catalog:",
		"relay-compiler": "catalog:",
		"relay-runtime": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"unplugin-icons": "catalog:",
		"vite": "catalog:",
		"vite-plugin-relay": "catalog:"
	},
	"devDependencies": {
		"@babel/preset-typescript": "catalog:",
		"@graphql-eslint/eslint-plugin": "catalog:",
		"@graphql-tools/mock": "catalog:",
		"@msw/playwright": "catalog:",
		"@playwright/test": "catalog:",
		"@types/flubber": "catalog:",
		"babel-plugin-react-compiler": "catalog:",
		"bundlewatch": "catalog:",
		"cross-env": "catalog:",
		"eslint": "catalog:",
		"eslint-config": "workspace:@animedes/eslint-config@*",
		"eslint-config-react": "workspace:@animedes/eslint-config-react@*",
		"eslint-plugin-relay": "workspace:@animedes/eslint-plugin-relay@*",
		"eslint-typegen": "catalog:",
		"flubber": "catalog:",
		"graphql-config": "catalog:",
		"msw": "catalog:",
		"nodemon": "catalog:",
		"temporal-polyfill-lite": "catalog:",
		"ts-config": "workspace:@animedes/ts-config@*",
		"tsx": "catalog:",
		"unplugin-macros": "catalog:",
		"vite-plugin-babel": "catalog:",
		"vite-plugin-inspect": "catalog:",
		"vitest": "catalog:"
	},
	"overrides": {
		"react-router-dom": "npm:react-router-dom@7.18.2"
	},
	"bundlewatch": {
		"files": [
			{
				"path": "dist/client/assets/*.js",
				"maxSize": "150kB"
			},
			{
				"path": "dist/client/assets/*.css",
				"maxSize": "25kB"
			}
		]
	}
}
