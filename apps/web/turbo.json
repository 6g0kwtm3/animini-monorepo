{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"dev": { "with": ["relay-watch"] },
		"build": {
			"dependsOn": ["^build", "relay"],
			"passThroughEnv": [
				"SENTRY_AUTH_TOKEN",
				/** this is set with --mode e2e (not an actual env var) */
				"MODE"
			],
			"env": ["CF_PAGES_BRANCH"]
		},
		"build-preview": {
			"dependsOn": ["^build", "relay"],
			"outputs": ["dist/**"],
			"passThroughEnv": [
				"SENTRY_AUTH_TOKEN",
				/** this is set with --mode e2e (not an actual env var) */
				"MODE"
			],
			"env": ["CF_PAGES_BRANCH"]
		},
		"start": { "cache": false, "persistent": true, "dependsOn": ["build"] },
		"relay-watch": { "cache": false, "persistent": true },
		"paraglide": {
			"outputs": ["app/paraglide/**"],
			"inputs": ["messages/**", "project.inlang/settings.json"]
		},
		"router": { "outputs": [".react-router/**"] },
		"relay": { "outputs": ["app/gql/**"] },
		"check": { "dependsOn": ["transit", "router", "paraglide", "relay"] },
		"lint": { "dependsOn": ["transit", "router", "paraglide", "relay"] }
	}
}
