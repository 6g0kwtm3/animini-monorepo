{
	"$schema": "https://json.schemastore.org/package",
	"name": "m3-react",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./Button": "./src/button.tsx"
	},
	"scripts": {
		"eslint-typegen": "node --import=tsx eslint.config.ts",
		"lint": "eslint --cache .",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"eslint": "catalog:",
		"eslint-config": "workspace:*",
		"eslint-config-react": "workspace:*",
		"eslint-typegen": "catalog:",
		"m3-core": "workspace:*",
		"ts-config": "workspace:^",
		"tsx": "catalog:"
	},
	"dependencies": {
		"@ariakit/react": "catalog:",
		"m3-styled-system": "workspace:*"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	}
}
