		"@ariakit/react": "catalog:",
		"@codspeed/vitest-plugin": "catalog:",
		"eslint": "catalog:",
		"eslint-config": "workspace:*",
		"eslint-config-react": "workspace:*",
		"eslint-typegen": "catalog:",
		"ts-config": "workspace:^",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"utilities": "workspace:^",
		"vitest": "catalog:"
	}
}
