{
	"$schema": "https://json.schemastore.org/package",
	"name": "@anitrove/unstyled",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/unstyled.ts",
		"./value": "./src/unstyled-value.ts"
	},
	"scripts": {
		"eslint-typegen": "node --import=tsx eslint.config.ts",
