		"@animedes/design": "workspace:@animedes/design@*",
		"@animedes/unstyled": "workspace:@animedes/unstyled@*",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"eslint": "catalog:",
		"eslint-config": "workspace:@animedes/eslint-config@*",
		"eslint-config-react": "workspace:@animedes/eslint-config-react@*",
		"ts-config": "workspace:@animedes/ts-config@*",
		"typescript": "npm:@typescript/typescript6@6.0.2",
