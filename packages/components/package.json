{
	"$schema": "https://json.schemastore.org/package",
	"name": "@animedes/components",
	"private": true,
	"version": "0.0.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tailwind": "./src/tailwind/index.ts"
	},
	"scripts": {
		"lint": "eslint --max-warnings 0 --cache . --fix",
