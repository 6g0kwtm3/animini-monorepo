{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": ["ts-config/tsconfig.json"],
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["unplugin-icons/types/react"]
	},
	"include": ["**/*"],
	"exclude": ["dist", "tmp"]
}