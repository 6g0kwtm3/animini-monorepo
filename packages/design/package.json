{
	"$schema": "https://json.schemastore.org/package",
	"name": "@animedes/design",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/design.ts",
		"./theme": "./src/design-theme.ts",
		"./colors": "./src/design-colors.ts",
		"./fonts": "./src/design-fonts.ts"
	},
	"scripts": {
		"eslint-typegen": "node --import=tsx eslint.config.ts",
		"lint": "vp lint --max-warnings 0 . --fix",
		"check": "tsgo --noEmit"
	},
	"peerDependencies": {
		"@anitrove/unstyled": "workspace:@animedes/unstyled@*"
	},
	"devDependencies": {
		"eslint-config": "workspace:@animedes/eslint-config@*",
		"eslint-typegen": "catalog:",
		"ts-config": "workspace:@animedes/ts-config@*",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"utilities": "workspace:@animedes/utilities@*"
	},
	"dependencies": {
		"csstype": "catalog:"
	}
}
