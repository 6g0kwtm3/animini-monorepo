{
	"$schema": "https://json.schemastore.org/package",
	"name": "@anitrove/design",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/design.ts",
		"./theme": "./src/design-theme.ts",
		"./colors": "./src/design-colors.ts",
		"./fonts": "./src/design-fonts.ts"
	},
	"scripts": {
		"eslint-typegen": "node --import=tsx eslint.config.ts",
		"lint": "eslint --cache . --fix",
		"check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@anitrove/unstyled": "workspace:*"
	},
	"devDependencies": {
		"eslint": "catalog:",
		"eslint-config": "workspace:*",
		"eslint-typegen": "catalog:",
		"ts-config": "workspace:^",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"utilities": "workspace:*"
	}
}
